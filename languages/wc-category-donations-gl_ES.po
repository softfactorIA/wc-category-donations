#, php-format
msgid "Average donation percentage: %d%%"
msgstr "Porcentaxe media de doazón: %d%%"

#: includes/class-wc-category-donations-admin.php:368
msgid "Annual report (CSV)"
msgstr "Informe anual (CSV)"

#: includes/class-wc-category-donations-admin.php:369
msgid "Download all donations of a year (active and cancelled) as a CSV file."
msgstr "Descarga todas as doazóns dun ano (activas e canceladas) nun arquivo CSV."

#: includes/class-wc-category-donations-admin.php:396
msgid "Year"
msgstr "Ano"

#: includes/class-wc-category-donations-admin.php:398
msgid "Download donations CSV"
msgstr "Descargar doazóns CSV"

#. translators: %d is the year.
#: includes/class-wc-category-donations-admin.php:412
#, php-format
msgid "Cancelled donations (%d)"
msgstr "Doazóns canceladas (%d)"

#: includes/class-wc-category-donations-admin.php:413
msgid "Donations recorded for orders that are cancelled, refunded, trashed or left in draft are marked as cancelled and excluded from the totals above. Use the button to re-scan after bulk order changes."
msgstr "As doazóns rexistradas de pedidos cancelados, reembolsados, eliminados ou en borrador márcanse como canceladas e exclúense dos totais anteriores. Usa o botón para volver a escanear tras cambios masivos de pedidos."

#: includes/class-wc-category-donations-admin.php:418
msgid "Remove donations from cancelled/trashed orders"
msgstr "Eliminar doazóns de pedidos cancelados/eliminados"

#: includes/class-wc-category-donations-admin.php:422
msgid "No cancelled donations."
msgstr "Non hai doazóns canceladas."

#: includes/class-wc-category-donations-admin.php:428
msgid "Order"
msgstr "Pedido"

#: includes/class-wc-category-donations-admin.php:430
msgid "Amount"
msgstr "Importe"

#: includes/class-wc-category-donations-admin.php:431
msgid "Reason"
msgstr "Motivo"

#: includes/class-wc-category-donations-admin.php:432
msgid "Cancelled at"
msgstr "Cancelada o"

#: includes/class-wc-category-donations-admin.php:455
msgid "WooCommerce is not active. Shortcode previews require it."
msgstr "WooCommerce non está activo. As vistas previas de shortcodes requíreno."

#: includes/class-wc-category-donations-admin.php:465
msgid "Donation percentage (0-100) of the current product category, or of the category in the attribute."
msgstr "Porcentaxe de doazón (0-100) da categoría de produto actual, ou da categoría do atributo."

#: includes/class-wc-category-donations-admin.php:472
msgid "Donation cause text of the current product category, or of the category in the attribute."
msgstr "Texto da causa de doazón da categoría de produto actual, ou da categoría do atributo."

#: includes/class-wc-category-donations-admin.php:479
msgid "Donation amount for the current product: price (without tax) times the category percentage. Formatted with the store currency; format=\"0\" returns the plain number without markup."
msgstr "Importe de doazón do produto actual: prezo (sen impostos) pola porcentaxe da categoría. Formateado coa moeda da tenda; format=\"0\" devolve o número simple sen marcado."

#: includes/class-wc-category-donations-admin.php:482
msgid "Product page only"
msgstr "Só páxina de produto"

#: includes/class-wc-category-donations-admin.php:487
msgid "Donation amount for the current cart contents: net line totals times the category percentages, like the order recording. Shows 0 when nothing donates."
msgstr "Importe de doazón do contido actual do carriño: totais netos de liña polas porcentaxes de categoría, como no rexistro de pedidos. Mostra 0 cando nada doa."

#: includes/class-wc-category-donations-admin.php:490
msgid "Cart page only"
msgstr "Só páxina de carriño"

#: includes/class-wc-category-donations-admin.php:495
msgid "Total donated for the category (recorded donations) from the current context or the attribute. Shows an error when no category can be resolved; format=\"0\" returns the plain number and the error as plain text."
msgstr "Total doado para a categoría (doazóns rexistradas) desde o contexto actual ou o atributo. Mostra un erro cando non se pode resolver a categoría; format=\"0\" devolve o número simple e o erro como texto simple."

#: includes/class-wc-category-donations-admin.php:503
msgid "Grand total of all donations recorded by the plugin. format=\"0\" returns the plain number without markup."
msgstr "Total xeral de todas as doazóns rexistradas polo plugin. format=\"0\" devolve o número simple sen marcado."

#: includes/class-wc-category-donations-admin.php:511
msgid "Number of distinct orders with at least one active donation."
msgstr "Número de pedidos distintos con polo menos unha doazón activa."

#: includes/class-wc-category-donations-admin.php:518
msgid "Aggregate donation percentage across all orders with active donations (total donated divided by the net order value), rounded to an integer."
msgstr "Porcentaxe de doazón agregada de todos os pedidos con doazóns activas (total doado dividido entre o valor neto do pedido), redondeada a un enteiro."

